{
  "name": "debate-app",
  "private": true,
  "description": "Offline-first debate adjudication app for BP and UADC (Android + Windows)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Studio-of-Sadiq/debate-adjudicator.git"
  },
  "homepage": "https://github.com/The-Studio-of-Sadiq/debate-adjudicator#readme",
  "bugs": "https://github.com/The-Studio-of-Sadiq/debate-adjudicator/issues",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @debate/core",
    "typecheck": "npm run typecheck -w @debate/core -w app",
    "app": "npm run start -w app",
    "web": "npm run web -w app",
    "android": "npm run android -w app",
    "desktop": "npm run start -w desktop",
    "desktop:dev": "npm run dev -w desktop",
    "postinstall": "node -e \"try{require.resolve('electron/install.js')&&require('electron/install.js')}catch{}\"",
    "check:i18n": "npm run check:i18n -w app"
  }
}
