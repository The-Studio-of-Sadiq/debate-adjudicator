{
  "name": "debate-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @debate/core",
    "typecheck": "npm run typecheck -w @debate/core -w app",
    "app": "npm run start -w app",
    "web": "npm run web -w app",
    "android": "npm run android -w app",
    "desktop": "npm run start -w desktop",
    "desktop:dev": "npm run dev -w desktop",
    "postinstall": "node -e \"try{require.resolve('electron/install.js')&&require('electron/install.js')}catch{}\"",
    "check:i18n": "npm run check:i18n -w app"
  }
}
