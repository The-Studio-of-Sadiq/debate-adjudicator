# Copy this file to .env and fill it in. .env is ignored by git; never commit keys.
# These are for trying providers with `npm run transcribe:try`. The app itself
# takes keys in Transcription settings, not from this file.

# Which provider `transcribe:try` uses: elevenlabs or groq.
TRANSCRIBE_PROVIDER=elevenlabs
# Language spoken in the recording: bn (Bangla) or en (English).
TRANSCRIBE_LANGUAGE=bn

# ElevenLabs Scribe, the most accurate for Bangla in our tests
# (https://elevenlabs.io/app/settings/api-keys).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2

# Groq, free Whisper for testing (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
