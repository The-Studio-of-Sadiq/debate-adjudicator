# Copy this file to .env and fill it in. .env is ignored by git; never commit keys.

# Groq API key for trying cloud transcription (https://console.groq.com/keys).
# Used by `npm run transcribe:try`. The app itself takes keys in
# Transcription settings, not from this file.
GROQ_API_KEY=

# Optional: model and language for `npm run transcribe:try`.
GROQ_MODEL=whisper-large-v3
TRANSCRIBE_LANGUAGE=bn
